        "scriptData": [
          {
            "script": "// Expanded Criticals: roll at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Penetrated Skull by hand.\");\nif (!api.turnReady(this)) return;\nif (await api.chanceRoll(this, 10, \"going Unconscious (until Extraction)\")) {\n  await this.actor.addCondition(\"unconscious\");\n  await api.stopTurnTests(this);\n}",
            "label": "Start of Turn: 10% going Unconscious (until Extraction)",
            "trigger": "startTurn",
            "options": {
