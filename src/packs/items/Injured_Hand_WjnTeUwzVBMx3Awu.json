        "scriptData": [
          {
            "script": "// Expanded Criticals: roll at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Injured Hand by hand.\");\nif (!api.turnReady(this)) return;\nconst roll = await new Roll(\"ceil(1d10 / 2) - 1\").evaluate();\nawait roll.toMessage({speaker: ChatMessage.getSpeaker({actor: this.actor}), flavor: `<strong>Injured Hand</strong>: the hand counts as having lost ${roll.total} finger(s) this turn (see Amputated Parts).`});",
            "label": "Start of Turn: Injured Hand",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
            "async": true
          }
