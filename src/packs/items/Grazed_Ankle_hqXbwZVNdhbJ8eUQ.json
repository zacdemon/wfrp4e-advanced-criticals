        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Grazed Ankle by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {skills: [\"Cool\",\"Endurance\"], difficulty: \"challenging\", success: \"Ignores the -1 M penalty this turn.\", failure: \"The -1 M penalty stays (at -4 SL or worse the cut opens further: no more Tests).\", optional: true});\n  if (test) {\n    if (test.failed) {\n      if (Number(test.result?.SL ?? 0) <= -4) await api.stopTurnTests(this, \"The cut opens further: no more Tests to ignore the -1 M penalty this encounter.\");\n    }\n    else {\n      await api.turnPenalty(this, {modifier: 0, physical: false, move: 1, label: \"+1 M this turn\"});\n    }\n  }\n}",
            "label": "Start of Turn: Cool or Endurance Test",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
            "async": true
          }
