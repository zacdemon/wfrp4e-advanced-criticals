        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the end of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Spinal Burn by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {skill: \"Endurance\", difficulty: \"hard\", success: \"Regains the use of both legs.\"});\n  if (test) {\n    if (test.failed) {\n      // no further effect\n    }\n    else {\n      await api.removeGranted(this, \"Amputated Leg\", \"any\");\n      await api.stopTurnTests(this, \"Regains the use of both legs (Amputated Legs removed).\");\n    }\n  }\n}",
            "label": "End of Turn: Endurance Test",
            "trigger": "endTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
            "async": true
          }
        ],
