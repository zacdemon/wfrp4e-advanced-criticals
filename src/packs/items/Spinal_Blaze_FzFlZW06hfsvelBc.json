        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Spinal Blaze by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {characteristic: \"t\", difficulty: \"difficult\", success: \"The paralysis passes: Unconscious removed.\"});\n  if (test) {\n    if (test.failed) {\n      // no further effect\n    }\n    else {\n      await this.actor.removeCondition(\"unconscious\");\n      await api.stopTurnTests(this);\n    }\n  }\n}",
            "label": "Start of Turn: T Test",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
            "async": true
          }
