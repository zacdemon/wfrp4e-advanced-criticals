        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"average\", failure: \"-10 to all Agility Tests for the next 1d10 turns.\"});\n  if (test) {\n    if (test.failed) {\n      const turns = (await new Roll(\"1d10\").evaluate()).total;\n      await api.addEffect(this, {name: `Shin Hit: -10 Agility (${turns} turns)`, script: \"args.fields.modifier -= 10;\", activateScript: \"return args.characteristic == 'ag';\", hideScript: \"return args.characteristic != 'ag';\", rounds: turns});\n      await api.gmNote(this, `-10 to Agility Tests for ${turns} turns.`);\n    }\n  }\n}",
            "label": "Test: Endurance",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
            },
