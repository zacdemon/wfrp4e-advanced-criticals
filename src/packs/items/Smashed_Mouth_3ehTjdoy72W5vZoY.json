          {
            "script": "// Expanded Criticals: Smashed Mouth grants Amputated Teeth (generated by tools/grants.mjs).\nconst grant = async (id, value, key = this.item.system.location?.key) => {\n  const item = await fromUuid(`Compendium.wfrp4e-core.items.Item.${id}`);\n  if (!item) return ui.notifications.error(`Expanded Criticals: core item ${id} not found (is WFRP4e Core active?). Add it by hand.`);\n  const data = item.toObject();\n  // skipLocationValue keeps our display value (\"5 Teeth\", \"Right Hand\", \"Nose\") instead of the one derived from the key (\"Head\")\n  let skipLocationValue = false;\n  if (data.type === \"injury\" && data.system.location) {\n    if (key) data.system.location.key = key;\n    if (value) data.system.location.value = value;\n    skipLocationValue = !!value || [\"Teeth\", \"Nose\", \"Tongue\", \"Eye\", \"Ear\"].includes(data.system.location.value);\n  }\n  return this.actor.createEmbeddedDocuments(\"Item\", [data], {skipLocationValue});\n};\nconst rollCount = async (formula, div = 1, add = 0, flavor) => {\n  const roll = await new Roll(formula).evaluate({allowInteractive: false});\n  if (flavor && /d/i.test(formula)) await roll.toMessage(this.script.getChatData({flavor}));\n  return Math.max(1, Math.ceil(roll.total / div) + add);\n};\nconst n = await rollCount(\"1d10\", 1, 0, \"Teeth Lost\");\nawait grant(\"fBcZhOBn8IpoVqQ1\", `${n} Teeth`);",
