        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"challenging\"});\n  if (test) {\n    if (test.failed) {\n      await this.actor.addCondition(\"unconscious\");\n    }\n    else {\n      await this.actor.addCondition(\"stunned\", 3);\n    }\n    await api.gmNote(this, \"Also: Broken Bone (Major) and 1d10 teeth lost (Amputation (Average)); add them by hand. If the projectile was a Lead Bullet, a Challenging (+0) Toughness Test is needed to keep the tongue.\");\n  }\n}",
            "label": "Test: Endurance",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
            },
