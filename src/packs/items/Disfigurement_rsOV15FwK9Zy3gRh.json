              "defending": false,
              "deleteEffect": false
            },
            "async": false
          },
          {
            "trigger": "endRound",
            "label": "Roll to remove Stunned",
            "script": "const test = await this.actor.setupSkill(game.i18n.localize(\"NAME.Endurance\"), {fields: {difficulty: \"challenging\"}, skipTargets: true, appendTitle :  ` - ${this.effect.name}`, context: {success: \"Removed SL + 1 Conditions.\", failure: \"Failed to remove Conditions.\"}});\nawait test.roll();\nif (test.succeeded) {\n  const toRemove = 1 + Number(test.result.SL);\n  this.actor.removeCondition(\"stunned\", toRemove);\n}",
            "options": {
              "targeter": false,
              "defending": false,
              "deleteEffect": false
            },
            "async": false
