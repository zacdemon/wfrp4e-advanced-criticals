        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {characteristic: \"t\", difficulty: \"average\", failure: \"Lose one tooth per SL of failure.\"});\n  if (test) {\n    if (test.failed) {\n      const teeth = Math.max(1, Math.abs(test.result.SL));\n      await api.addCoreItem(this, \"teeth\", d => { d.system.location.value = `${teeth} ${d.system.location.value}`; });\n      await api.gmNote(this, `Loses ${teeth} tooth/teeth.`);\n    }\n  }\n}",
            "label": "Test: t",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
            },
            "async": false
          }
