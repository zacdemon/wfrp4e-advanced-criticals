        "scriptData": [
          {
            "script": "// Expanded Criticals: roll at the end of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Crushed Larynx by hand.\");\nif (!api.turnReady(this)) return;\nawait this.actor.addCondition(\"fatigued\");\nconst level = Number(this.actor.hasCondition(\"fatigued\")?.conditionValue ?? 0);\nif (level >= 10) {\n  await this.actor.addCondition(\"unconscious\");\n  await api.stopTurnTests(this, `Fatigued (${level}): Unconscious, and dies of suffocation in ${this.actor.system.characteristics.t.bonus} rounds (Toughness Bonus) unless the airway is cleared.`);\n}\nelse await api.turnNote(this, `Gains a Fatigued Condition (now ${level}).`);",
            "label": "End of Turn: Crushed Larynx",
            "trigger": "endTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
