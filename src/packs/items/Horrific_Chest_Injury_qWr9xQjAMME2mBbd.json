        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {skill: \"Athletics\", difficulty: \"average\"});\n  if (test) {\n    if (test.failed) {\n      await this.actor.addCondition(\"prone\");\n    }\n  }\n}\n{\n  const test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"easy\", failure: \"Contract a Minor Infection (if the GM uses the Infection rules).\"});\n  if (test) {\n    if (test.failed) {\n      await api.addCoreItem(this, \"minor\");\n      await api.gmNote(this, \"Minor Infection added. Delete it if you are not using the Infection rules.\");\n    }\n  }\n}",
            "label": "Test: Athletics, Endurance",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
            },
            "async": false
          }
