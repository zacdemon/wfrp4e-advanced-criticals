        "scriptData": [
          {
            "script": "// Expanded Criticals: Destroyed Face grants Destroyed Face: lost parts (generated by tools/grants.mjs).\nconst grant = async (id, value, key = this.item.system.location?.key) => {\n  const item = await fromUuid(`Compendium.wfrp4e-core.items.Item.${id}`);\n  if (!item) return ui.notifications.error(`Expanded Criticals: core item ${id} not found (is WFRP4e Core active?). Add it by hand.`);\n  const data = item.toObject();\n  // skipLocationValue keeps our display value (\"5 Teeth\", \"Right Hand\", \"Nose\") instead of the one derived from the key (\"Head\")\n  let skipLocationValue = false;\n  if (data.type === \"injury\" && data.system.location) {\n    if (key) data.system.location.key = key;\n    if (value) data.system.location.value = value;\n    skipLocationValue = !!value || [\"Teeth\", \"Nose\", \"Tongue\", \"Eye\", \"Ear\"].includes(data.system.location.value);\n  }\n  return this.actor.createEmbeddedDocuments(\"Item\", [data], {skipLocationValue});\n};\nconst rollCount = async (formula, div = 1, add = 0, flavor) => {\n  const roll = await new Roll(formula).evaluate({allowInteractive: false});\n  if (flavor && /d/i.test(formula)) await roll.toMessage(this.script.getChatData({flavor}));\n  return Math.max(1, Math.ceil(roll.total / div) + add);\n};\nconst side = (s) => s === \"Left\" ? \"l\" : \"r\";\nconst lose = async (part, s) => {\n  switch (part) {\n    case \"ear\": return grant(\"8piWcBKFlQ2J1E3A\", `${s} Ear`, side(s) + \"Ear\");\n    case \"eye\": return grant(\"weczkAMPlTjX7lqU\", `${s} Eye`, side(s) + \"Eye\");\n    case \"nose\": return grant(\"SpPRZZRHxly7uo2G\");\n    case \"teeth\": { const n = await rollCount(\"1d10\", 1, 0, \"Teeth Lost\"); return grant(\"fBcZhOBn8IpoVqQ1\", `${n} Teeth`); }\n  }\n};\n// Roll three times, ignoring (not rerolling) results already rolled.\nconst lost = new Set();\nfor (let i = 0; i < 3; i++) {\n  const r = (await new Roll(\"1d10\").evaluate({allowInteractive: false}));\n  await r.toMessage(this.script.getChatData({flavor: \"Destroyed Face: part lost\"}));\n  const t = r.total;\n  lost.add(t <= 2 ? \"lear\" : t <= 4 ? \"rear\" : t <= 6 ? \"nose\" : t === 7 ? \"teeth1\" : t === 8 ? \"teeth2\" : t === 9 ? \"eye1\" : \"eyes\");\n}\nif (lost.has(\"lear\")) await lose(\"ear\", \"Left\");\nif (lost.has(\"rear\")) await lose(\"ear\", \"Right\");\nif (lost.has(\"nose\")) await lose(\"nose\");\nif (lost.has(\"teeth1\")) await lose(\"teeth\");\nif (lost.has(\"teeth2\")) await lose(\"teeth\");\nif (lost.has(\"eyes\")) { await lose(\"eye\", \"Left\"); await lose(\"eye\", \"Right\"); }\nelse if (lost.has(\"eye1\")) await lose(\"eye\", (await new Roll(\"1d2\").evaluate()).total === 1 ? \"Left\" : \"Right\");",
