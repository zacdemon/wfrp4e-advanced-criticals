        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Sprained Finger by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {skill: \"Endurance\", difficulty: \"challenging\", success: \"The hand can be used again (one finger stays useless until the end of the encounter).\"});\n  if (test) {\n    if (test.failed) {\n      // no further effect\n    }\n    else {\n      await api.stopTurnTests(this, \"The hand can be used again; one finger stays useless until the end of the encounter.\");\n    }\n  }\n}",
            "label": "Start of Turn: Endurance Test",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
