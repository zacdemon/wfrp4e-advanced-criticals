        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Severed Clavicle by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {skill: \"Endurance\", difficulty: \"difficult\", success: \"Overcomes the pain: the arm can be used again (still -20 to Tests with it until the bone sets).\"});\n  if (test) {\n    if (test.failed) {\n      // no further effect\n    }\n    else {\n      await api.stopTurnTests(this, \"Overcomes the pain: the arm can be used again (still -20 to Tests with that arm, and -10 to physical movement, until the bone sets).\");\n    }\n  }\n}",
            "label": "Start of Turn: Endurance Test",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
