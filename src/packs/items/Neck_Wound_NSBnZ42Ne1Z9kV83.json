        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {skills: [\"Cool\",\"Endurance\"], difficulty: \"challenging\", failure: \"Drop what is in your primary hand to clap it to the wound.\"});\n  if (test) {\n    if (test.failed) {\n      await api.dropHeld(this, {where: \"primary\"});\n    }\n  }\n}",
            "label": "Test: Cool or Endurance",
