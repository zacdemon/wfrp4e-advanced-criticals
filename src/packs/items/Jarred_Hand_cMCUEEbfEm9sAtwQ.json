        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\nlet test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"average\", failure: \"Drop anything held in that hand.\"});\nif (!test) return;\n// Held in both hands: one reroll\nif (test.failed && (this.item.system.weaponsAtLocation ?? []).some(w => w.system.twohanded?.value))\n  test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"average\", title: `${this.item.name} (two hands: reroll)`, failure: \"Drop anything held in that hand.\"});\nif (test?.failed) await api.dropHeld(this, {where: \"location\"});",
            "label": "Test",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
