        "scriptData": [
          {
            "script": "// Expanded Criticals: roll at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Throat Punch by hand.\");\nif (!api.turnReady(this)) return;\nif (this.actor.hasCondition(\"stunned\")) return;\nconst level = Number(this.actor.hasCondition(\"fatigued\")?.conditionValue ?? 0);\nif (!level) return;\nif (level >= 3) {\n  await this.actor.removeCondition(\"fatigued\", level);\n  return api.stopTurnTests(this, \"The throat recovers: all Fatigued Conditions removed.\");\n}\nawait this.actor.addCondition(\"fatigued\");\nawait api.turnNote(this, `Struggling to breathe: Fatigued (${level + 1}).`);",
            "label": "Start of Turn: Throat Punch",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
