        "scriptData": [
          {
            "trigger": "dialog",
            "label": "Penalty to all Tests (@effect.name)",
            "script": "args.fields.modifier -= 10 * this.effect.conditionValue",
            "options": {
              "activateScript": "return true",
              "targeter": false,
              "defending": false,
