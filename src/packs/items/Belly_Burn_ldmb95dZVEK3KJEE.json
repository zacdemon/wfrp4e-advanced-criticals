        "scriptData": [
          {
            "script": "// Expanded Criticals: Test at the start of each of the afflicted creature's turns in combat (generated by tools/crit-tests.mjs).\n// warhammer-lib runs it once per round, on the client of the actor's active owner (its player if online, otherwise the GM).\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.turnTest) return ui.notifications.error(\"Expanded Criticals is not active: resolve Belly Burn by hand.\");\nif (!api.turnReady(this)) return;\n{\n  const test = await api.turnTest(this, {skill: \"Endurance\", difficulty: \"challenging\", failure: \"-20 to all physical Actions and Tests, and half Movement, for the rest of this turn.\"});\n  if (test) {\n    if (test.failed) {\n      await api.turnPenalty(this, {modifier: -20, physical: true, halveMove: true});\n    }\n  }\n}",
            "label": "Start of Turn: Endurance Test",
            "trigger": "startTurn",
            "options": {
              "targeter": false,
              "deleteEffect": false
            },
