        "scriptData": [
          {
            "script": "// Expanded Criticals: Test prompted when this critical is received (generated by tools/crit-tests.mjs).\n// Rolled by the actor's player when the GM adds it (module setting \"Who rolls critical Tests\").\nconst api = game.modules.get(\"artantares-advanced-criticals\")?.api;\nif (!api?.rollCritTest) return ui.notifications.error(\"Expanded Criticals is not active: roll this critical's Test by hand.\");\n{\n  const test = await api.rollCritTest(this, {skill: \"Endurance\", difficulty: \"challenging\", failure: \"-10 to Tests with that arm until you pass this Test.\"});\n  if (test) {\n    if (test.failed) {\n      await api.addEffect(this, {name: `${this.item.name}: -10 (Tests with the bruised arm)`, script: \"args.fields.modifier -= 10;\"});\n      await api.gmNote(this, \"-10 to Tests using that arm until the Test is passed (tick the modifier in the roll dialog; delete the effect once it is passed).\");\n    }\n  }\n}",
            "label": "Test: Endurance",
            "trigger": "immediate",
            "options": {
              "targeter": false,
              "deleteEffect": true
            },
